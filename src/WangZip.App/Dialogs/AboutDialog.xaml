<Window x:Class="WangZip.App.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="왕집 정보"
        Width="520" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                <TextBlock Text="M" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="왕집 (WangZip) 0.1.0" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="광고 없는 오픈소스 압축 프로그램" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,18,0,12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="이 프로그램은 GPL-3.0으로 배포됩니다. 광고, 번들 소프트웨어, 사용 추적이 없습니다." />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="지원 형식" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="ZIP (읽기/쓰기, ZIP64, 한글 파일명 자동 복원) · 7z · TAR · GZ · BZ2 · XZ · RAR 읽기 (SharpCompress)" />

                <TextBlock Text="오픈소스 구성요소" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                    <Run Text="SharpCompress (MIT) — 7z/TAR/RAR 등 읽기" /><LineBreak />
                    <Run Text=".NET 10 / WPF (MIT) — UI 및 런타임" /><LineBreak />
                    <Run Text="직접 구현 — ZIP 파서, 한글 인코딩 판별, 경로 안전 계층" />
                </TextBlock>

                <TextBlock Text="v0.1 제한 사항" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap"
                           Text="암호가 걸린 압축 파일, 분할 ZIP/RAR, 7z 쓰기, RAR 쓰기는 아직 지원하지 않습니다. RAR 생성은 공개된 오픈소스 구현이 없어 지원 계획이 없습니다." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="Close_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
