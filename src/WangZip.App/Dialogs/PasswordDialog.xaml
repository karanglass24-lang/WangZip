<Window x:Class="WangZip.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="압축 파일 비밀번호"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="이 압축 파일에는 비밀번호가 걸려 있습니다."
                   TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Text="비밀번호를 입력하면 내용을 풀 수 있습니다."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,4,0,12" />

        <TextBlock Text="비밀번호" Margin="0,0,0,6" />
        <PasswordBox x:Name="PasswordInput" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                     BorderBrush="{StaticResource BorderBrush}" />
        <TextBox x:Name="RevealBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                 BorderBrush="{StaticResource BorderBrush}" Visibility="Collapsed" />
        <CheckBox x:Name="ShowPasswordBox" Content="비밀번호 표시" Margin="0,8,0,0"
                  Checked="ShowPassword_CheckedChanged" Unchecked="ShowPassword_CheckedChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="확인" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
