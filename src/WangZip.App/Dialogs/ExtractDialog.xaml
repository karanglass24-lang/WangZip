<Window x:Class="WangZip.App.Dialogs.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="압축 풀기"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 풀 위치 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="압축을 풀 폴더" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="DestinationBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource BorderBrush}" />
                <Button Grid.Column="1" Content="찾아보기..." Style="{StaticResource SecondaryButton}" Click="Browse_Click"
                        Margin="8,0,0,0" MinWidth="86" />
                <Button Grid.Column="2" x:Name="OpenFolderButton" Content="폴더 열기" Style="{StaticResource SecondaryButton}"
                        Click="OpenFolder_Click" Margin="6,0,0,0" MinWidth="86"
                        ToolTip="압축을 푼 폴더(또는 지정한 폴더)를 탐색기로 엽니다." />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="빠른 위치:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox x:Name="QuickDestCombo" Width="280" MinHeight="30" DisplayMemberPath="Label"
                          SelectionChanged="QuickDest_Changed" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 2. 대상 -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="대상" Style="{StaticResource SectionTitle}" />
            <RadioButton x:Name="AllRadio" Content="전체 항목 압축 풀기" Margin="0,0,0,6" IsChecked="True" />
            <RadioButton x:Name="SelectedOnlyRadio">
                <TextBlock x:Name="SelectedCountText" Text="선택한 항목만 압축 풀기" />
            </RadioButton>
        </StackPanel>

        <!-- 3. 옵션 -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="같은 이름의 파일이 있을 때" Style="{StaticResource SectionTitle}" />
            <ComboBox x:Name="OverwriteCombo" Width="220" Height="32" HorizontalAlignment="Left" DisplayMemberPath="Label" />
            <CheckBox x:Name="AutoOpenBox" Content="압축을 푼 뒤 그 폴더 열기" Margin="0,12,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="파일명이 깨져 보이면 메인 창의 '파일명 인코딩'을 UTF-8 또는 CP949로 바꾼 뒤 다시 시도하세요." />

        <Border Grid.Row="4" Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="압축 풀기" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
