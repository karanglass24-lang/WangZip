<Window x:Class="WangZip.App.Dialogs.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="압축 풀기"
        Width="620" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="압축을 풀 폴더" Style="{StaticResource SectionTitle}" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="DestinationBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     BorderBrush="{StaticResource BorderBrush}" />
            <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButton}" Click="Browse_Click" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="빠른 선택:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <Button Content="바탕 화면" Style="{StaticResource SecondaryButton}" Click="QuickLocation_Click" Tag="Desktop" Margin="8,0,0,0" MinWidth="70" />
            <Button Content="다운로드" Style="{StaticResource SecondaryButton}" Click="QuickLocation_Click" Tag="Downloads" Margin="8,0,0,0" MinWidth="70" />
            <Button Content="문서" Style="{StaticResource SecondaryButton}" Click="QuickLocation_Click" Tag="Documents" Margin="8,0,0,0" MinWidth="60" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="대상" Style="{StaticResource SectionTitle}" />

        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <RadioButton x:Name="AllRadio" Content="전체 항목 압축 풀기" Margin="0,0,0,6" IsChecked="True" />
            <RadioButton x:Name="SelectedOnlyRadio">
                <TextBlock x:Name="SelectedCountText" Text="선택한 항목만 압축 풀기" />
            </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="같은 이름의 파일이 있을 때" Style="{StaticResource SectionTitle}" />
            <ComboBox x:Name="OverwriteCombo" Width="220" Height="32" HorizontalAlignment="Left" DisplayMemberPath="Label" />
            <CheckBox x:Name="AutoOpenBox" Content="압축을 푼 뒤 그 폴더 열기" Margin="0,12,0,0" />
            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="파일명이 깨져 보이면 메인 창의 '파일명 인코딩'을 UTF-8 또는 CP949로 바꾼 뒤 다시 시도하세요." />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="압축 풀기" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
