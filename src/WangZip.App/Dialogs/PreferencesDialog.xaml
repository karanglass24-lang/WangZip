<Window x:Class="WangZip.App.Dialogs.PreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="환경설정"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="일반" FontWeight="SemiBold" />
        <CheckBox x:Name="AutoOpenBox" Content="압축을 풀면 폴더를 자동으로 엽니다" Margin="0,8,0,0" />
        <CheckBox x:Name="AutoUpdateBox" Content="실행할 때 새 버전을 확인하고 자동으로 업데이트합니다 (설치형)" Margin="0,6,0,0" />

        <Separator Margin="0,16" />

        <TextBlock Text="탐색기 우클릭 메뉴" FontWeight="SemiBold" />
        <CheckBox x:Name="ShellMenuBox" Margin="0,8,0,0"
                  Content="'왕집: 여기에 풀기' (ZIP·7z·RAR·tar 등), 모든 파일·폴더의 '왕집: ZIP으로 압축' 메뉴를 추가합니다" />
        <TextBlock Text="Windows 11에서는 '더 많은 옵션 표시' 아래에 나타납니다."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,0" />

        <Separator Margin="0,16" />

        <TextBlock Text="파일 형식 연결" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"
                   Text="체크한 형식은 '연결 프로그램' 목록에 왕집이 나타납니다. 더블클릭으로 바로 열리게 하려면 아래 버튼으로 Windows 설정에서 왕집을 기본 앱으로 선택하세요. (Windows가 앱이 직접 기본 앱을 바꾸는 것을 허용하지 않습니다)" />
        <WrapPanel x:Name="ExtensionPanel" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="모두 선택" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click" Margin="0,0,8,0" />
            <Button Content="모두 해제" Style="{StaticResource SecondaryButton}" Click="SelectNone_Click" Margin="0,0,8,0" />
            <Button Content="Windows 기본 앱 설정 열기" Style="{StaticResource SecondaryButton}" Click="OpenDefaultApps_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="저장" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
