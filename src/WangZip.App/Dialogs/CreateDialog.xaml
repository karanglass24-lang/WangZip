<Window x:Class="WangZip.App.Dialogs.CreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축하기"
        Width="660" Height="580"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="압축할 파일과 폴더" Style="{StaticResource SectionTitle}" />

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,10">
            <ListBox x:Name="SourceList"
                     ItemsSource="{Binding Sources, RelativeSource={RelativeSource AncestorType=Window}}"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     Padding="6" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="파일 추가" Style="{StaticResource SecondaryButton}" Click="AddFiles_Click" Margin="0,0,8,0" />
            <Button Content="폴더 추가" Style="{StaticResource SecondaryButton}" Click="AddFolder_Click" Margin="0,0,8,0" />
            <Button Content="선택 제거" Style="{StaticResource SecondaryButton}" Click="Remove_Click" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="저장 위치" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="OutputBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     BorderBrush="{StaticResource BorderBrush}" />
            <Button Grid.Column="2" Content="찾아보기" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click" Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="압축 수준" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="LevelCombo" Height="32" DisplayMemberPath="Label" />
            <TextBlock Grid.Column="3" Text="파일명 인코딩" VerticalAlignment="Center" />
            <ComboBox Grid.Column="4" x:Name="EncodingCombo" Height="32" DisplayMemberPath="Label" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="압축하기" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
