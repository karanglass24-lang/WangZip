<Window x:Class="WangZip.App.Dialogs.CreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="압축하기"
        Width="660" Height="700"
        MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="압축할 파일과 폴더" Style="{StaticResource SectionTitle}" />

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,10">
            <ListBox x:Name="SourceList"
                     ItemsSource="{Binding Sources, RelativeSource={RelativeSource AncestorType=Window}}"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     Padding="6" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="파일 추가" Style="{StaticResource SecondaryButton}" Click="AddFiles_Click" Margin="0,0,8,0" />
            <Button Content="폴더 추가" Style="{StaticResource SecondaryButton}" Click="AddFolder_Click" Margin="0,0,8,0" />
            <Button Content="선택 제거" Style="{StaticResource SecondaryButton}" Click="Remove_Click" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="저장 위치" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="OutputBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     BorderBrush="{StaticResource BorderBrush}" />
            <Button Grid.Column="2" Content="찾아보기" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click" Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="압축 수준" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="LevelCombo" Height="32" DisplayMemberPath="Label" />
            <TextBlock Grid.Column="3" Text="파일명 인코딩" VerticalAlignment="Center" />
            <ComboBox Grid.Column="4" x:Name="EncodingCombo" Height="32" DisplayMemberPath="Label" />
        </Grid>

        <Border Grid.Row="5" Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="UsePasswordCheck" Content="암호 걸기 (AES-256)"
                          FontWeight="SemiBold" Checked="UsePassword_Changed" Unchecked="UsePassword_Changed" />
                <Grid x:Name="PasswordPanel" Margin="0,10,0,0" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="비밀번호" VerticalAlignment="Center" />
                    <PasswordBox Grid.Column="1" x:Name="PasswordBox" Height="32" Padding="8,0"
                                 VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" />
                    <TextBlock Grid.Column="3" Text="비밀번호 확인" VerticalAlignment="Center" />
                    <PasswordBox Grid.Column="4" x:Name="PasswordConfirmBox" Height="32" Padding="8,0"
                                 VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" />
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Windows 기본 압축 풀기에서는 열 수 없습니다. 왕집·7-Zip·반디집에서 열 수 있습니다." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="압축하기" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="100" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
