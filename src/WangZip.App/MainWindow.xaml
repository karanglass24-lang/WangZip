<Window x:Class="WangZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WangZip.Core;assembly=WangZip.Core"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Title="{Binding Title}"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,1">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="압축 파일 열기..." InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem Header="압축하기..." InputGestureText="Ctrl+N" Click="Create_Click" />
                <Separator />
                <MenuItem Header="끝내기" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="압축 풀기 (대상 폴더 선택)..." InputGestureText="Ctrl+E" Click="QuickExtractAll_Click" />
                <MenuItem Header="선택 항목만 압축 풀기" Click="QuickExtractSelected_Click" />
                <Separator />
                <MenuItem Header="무결성 검사" Click="Verify_Click" />
                <Separator />
                <MenuItem Header="파일명 인코딩">
                    <MenuItem x:Name="EncodingAutoMenu" Header="자동 감지 (권장)" IsCheckable="True"
                              Tag="Auto" Click="EncodingMenu_Click" />
                    <MenuItem x:Name="EncodingUtf8Menu" Header="UTF-8" IsCheckable="True"
                              Tag="Utf8" Click="EncodingMenu_Click" />
                    <MenuItem x:Name="EncodingCp949Menu" Header="CP949 / EUC-KR (구형)" IsCheckable="True"
                              Tag="Cp949" Click="EncodingMenu_Click" />
                    <MenuItem x:Name="EncodingRawMenu" Header="원본 바이트" IsCheckable="True"
                              Tag="Raw" Click="EncodingMenu_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="선택 항목을 ZIP에서 삭제" Click="Delete_Click" />
                <Separator />
                <MenuItem Header="새로 고침" InputGestureText="F5" Click="Refresh_Click" />
                <Separator />
                <MenuItem Header="환경설정..." Click="Preferences_Click" />
                <Separator />
                <MenuItem x:Name="AutoUpdateMenu" Header="자동 업데이트 사용" IsCheckable="True" Click="AutoUpdateMenu_Click" />
                <MenuItem Header="업데이트 확인..." Click="CheckUpdates_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="왕집 정보" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7,10,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- 열기 -->
                    <Button Style="{StaticResource RibbonTool}" Click="Open_Click" ToolTip="압축 파일 열기 (Ctrl+O)">
                        <StackPanel>
                            <Image Source="/Assets/tool-open.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="열기" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 빠른 압축 풀기(전체) -->
                    <Button x:Name="QuickAll" Style="{StaticResource RibbonTool}" Click="QuickExtractAll_Click"
                            IsEnabled="{Binding HasArchive}" ToolTip="압축 풀기(대상 폴더를 선택해 풉니다) (Ctrl+E)">
                        <StackPanel>
                            <Image Source="/Assets/tool-extract.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="압축 풀기" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 선택 압축 풀기 -->
                    <Button x:Name="QuickSel" Style="{StaticResource RibbonTool}" Click="QuickExtractSelected_Click"
                            IsEnabled="{Binding HasArchive}" ToolTip="목록에서 선택한 항목만 풀기">
                        <StackPanel>
                            <Image Source="/Assets/tool-extract-selected.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="선택 풀기" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,4" />

                    <!-- 압축하기 -->
                    <Button x:Name="CreateButton" Style="{StaticResource RibbonTool}" Click="Create_Click" ToolTip="새 압축 파일 만들기 (Ctrl+N)">
                        <StackPanel>
                            <Image Source="/Assets/tool-create.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="압축하기" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 파일 추가 -->
                    <Button x:Name="AddEntryButton" Style="{StaticResource RibbonTool}" Click="AddFiles_Click"
                            IsEnabled="{Binding HasArchive}" ToolTip="열려 있는 ZIP에 파일/폴더 추가">
                        <StackPanel>
                            <Image Source="/Assets/tool-add.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="파일 추가" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 항목 삭제 -->
                    <Button x:Name="DeleteEntryButton" Style="{StaticResource RibbonTool}" Click="Delete_Click"
                            IsEnabled="{Binding HasArchive}" ToolTip="선택 항목을 ZIP에서 삭제">
                        <StackPanel>
                            <Image Source="/Assets/tool-delete.png" Width="41" Height="41"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="항목 삭제" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,4" />

                    <!-- 검사 -->
                    <Button x:Name="VerifyButton" Style="{StaticResource RibbonTool}" Click="Verify_Click"
                            IsEnabled="{Binding HasArchive}" ToolTip="무결성 검사 (CRC)">
                        <StackPanel>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       HorizontalAlignment="Center" Foreground="#7B61C4" />
                            <TextBlock Text="검사" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 새로 고침 -->
                    <Button x:Name="RefreshButton" Style="{StaticResource RibbonTool}" Click="Refresh_Click"
                            ToolTip="새로 고침 (F5)">
                        <StackPanel>
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="새로 고침" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text="개 (현재 폴더 " /><Run Text="{Binding EntriesCount, Mode=OneWay}" /><Run Text="개)" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 폴더 트리 -->
                <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="폴더 계층" Style="{StaticResource SectionTitle}" Margin="0" />
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TreeView x:Name="FolderTree"
                                  ItemsSource="{Binding TreeRoots}"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged"
                                  ItemContainerStyle="{StaticResource TreeItem}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" />

                <DockPanel Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                    <!-- 경로 / 전체 보기 -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                                    Padding="8,3" Margin="0,0,8,0" MinWidth="54"
                                    IsEnabled="{Binding CanGoUp}" Click="GoUp_Click"
                                    ToolTip="상위 폴더로 이동 (Alt+↑ / Backspace)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="위로" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                    Padding="8,3" Content="전체" MinWidth="54" Margin="8,0,0,0"
                                    Click="ShowAll_Click" />
                            <Grid DockPanel.Dock="Right" Width="190" Margin="8,0,0,0">
                                <TextBox x:Name="SearchBox" Padding="6,3" VerticalContentAlignment="Center"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="압축 파일 전체에서 이름 검색 (Ctrl+F, Esc로 지우기)" />
                                <TextBlock Text="이름 검색" IsHitTestVisible="False" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="›" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="2,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource CrumbButton}" Content="{Binding Label}"
                                                    Tag="{Binding Path}" Click="Crumb_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="EntryGrid"
                              ItemsSource="{Binding Entries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              Background="{StaticResource SurfaceBrush}"
                              BorderThickness="0"
                              RowHeight="32"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserSortColumns="True"
                              Sorting="EntryGrid_Sorting"
                              PreviewMouseLeftButtonDown="EntryGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="EntryGrid_PreviewMouseMove"
                              PreviewMouseRightButtonDown="EntryGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="EntryGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="열기 (미리보기)" Click="ContextOpen_Click" />
                                <MenuItem Header="선택 항목 압축 풀기..." Click="QuickExtractSelected_Click" />
                                <Separator />
                                <MenuItem Header="항목 삭제" Click="Delete_Click" />
                                <Separator />
                                <MenuItem Header="상위 폴더로" Click="GoUp_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="이름" Width="*" MinWidth="200" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FolderGeometry}" Stretch="Uniform"
                                                      Fill="{Binding IconColor}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Border CornerRadius="3" Background="{Binding IconColor}" Width="18" Height="20">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding IconLabel}" Foreground="White" FontSize="7"
                                                               FontWeight="Bold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LockText}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="#7B61C4"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="110" SortMemberPath="Size" />
                            <DataGridTextColumn Header="압축 크기" Binding="{Binding CompressedText}" Width="110" SortMemberPath="Compressed" />
                            <DataGridTextColumn Header="압축률" Binding="{Binding RatioText}" Width="80" SortMemberPath="Ratio" />
                            <DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="140" SortMemberPath="Modified" />
                            <DataGridTextColumn Header="방식" Binding="{Binding MethodText}" Width="100" SortMemberPath="Method" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 파일 없을 때 안내 -->
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasArchive}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="압축 파일을 열어 주세요" FontSize="16" FontWeight="SemiBold" /><LineBreak />
                    <Run Text="Ctrl+O 또는 파일을 이 창으로 끌어다 놓으면 열립니다." />
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
