<Window x:Class="WangZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app-icon.ico"
        Title="{Binding Title}"
        Width="1120" Height="740"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,2">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="압축 파일 열기..." InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem Header="압축하기..." InputGestureText="Ctrl+N" Click="Create_Click" />
                <Separator />
                <MenuItem Header="끝내기" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="압축 풀기..." InputGestureText="Ctrl+E" Click="Extract_Click" />
                <MenuItem Header="무결성 검사..." Click="Verify_Click" />
                <Separator />
                <MenuItem Header="새로 고침" InputGestureText="F5" Click="Refresh_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="왕집 정보" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="Open_Click" ToolTip="압축 파일 열기 (Ctrl+O)">
                    <StackPanel>
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="열기" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButton}" Click="Extract_Click" ToolTip="압축 풀기 (Ctrl+E)">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="압축 풀기" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButton}" Click="Create_Click" ToolTip="압축하기 (Ctrl+N)">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="압축하기" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButton}" Click="Refresh_Click" ToolTip="새로 고침 (F5)">
                    <StackPanel>
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="새로 고침" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,4" />

                <TextBlock Text="파일명 인코딩" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                <ComboBox x:Name="EncodingCombo" Width="200" Height="30" VerticalAlignment="Center"
                          DisplayMemberPath="Label" SelectionChanged="Encoding_Changed" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding EncodingDescription}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,9"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding ArchivePath}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Grid.Row="1">
                <DataGrid x:Name="EntryGrid"
                          ItemsSource="{Binding Entries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource SurfaceBrush}"
                          BorderThickness="0"
                          RowHeight="32"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="EntryGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="압축 크기" Binding="{Binding CompressedText}" Width="110" />
                        <DataGridTextColumn Header="압축률" Binding="{Binding RatioText}" Width="80" />
                        <DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="140" />
                        <DataGridTextColumn Header="방식" Binding="{Binding MethodText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasArchive}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="압축 파일을 열어 주세요" FontSize="16" FontWeight="SemiBold" /><LineBreak />
                    <Run Text="Ctrl+O 또는 파일을 이 창으로 끌어다 놓으면 열립니다." />
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
