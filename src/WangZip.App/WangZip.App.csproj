<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WangZip.App</RootNamespace>
    <AssemblyName>WangZip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>WangZip</Product>
    <AssemblyTitle>WangZip - 광고 없는 압축 프로그램</AssemblyTitle>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WangZip.Core\WangZip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
